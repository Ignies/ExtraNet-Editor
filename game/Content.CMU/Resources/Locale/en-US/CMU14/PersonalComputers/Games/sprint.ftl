# sprint: strings for this game only.
cmu-game-sprint-title = 100 M
cmu-game-sprint-intro = LANE {$lane} {$name}
cmu-game-sprint-lane = LANE {$lane}
cmu-game-sprint-lead = LEAD {$name}
cmu-game-sprint-split = 50m {$time}
cmu-game-sprint-reaction = RT {$time}
cmu-game-sprint-rank = {$place ->
    [1] 1st
    [2] 2nd
    [3] 3rd
   *[other] {$place}th
}
cmu-game-sprint-place = {$place ->
    [1] 1st
    [2] 2nd
    [3] 3rd
   *[other] {$place}th
} {$time}
cmu-game-sprint-false-start = FALSE START!
cmu-game-sprint-faceplant = FACEPLANT!
cmu-game-sprint-hamstring = HAMSTRING!
cmu-game-sprint-tangled = TANGLED!
cmu-game-sprint-down = DOWN!
cmu-game-sprint-hurt = HURT
cmu-game-sprint-photo = PHOTO FINISH
cmu-game-sprint-finish-cam = FINISH CAM
cmu-game-sprint-record = MEET RECORD!
